{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/management-api/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/management-api/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/management-api",
  "projects": {
    "alert-engine": {
      "type": "application",
      "root": "apps/alert-engine",
      "entryFile": "main",
      "sourceRoot": "apps/alert-engine/src",
      "compilerOptions": {
        "tsConfigPath": "apps/alert-engine/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "ingest-service": {
      "type": "application",
      "root": "apps/ingest-service",
      "entryFile": "main",
      "sourceRoot": "apps/ingest-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ingest-service/tsconfig.app.json"
      }
    },
    "kafka-topics": {
      "type": "library",
      "root": "libs/kafka-topics",
      "entryFile": "index",
      "sourceRoot": "libs/kafka-topics/src",
      "compilerOptions": {
        "tsConfigPath": "libs/kafka-topics/tsconfig.lib.json"
      }
    },
    "management-api": {
      "type": "application",
      "root": "apps/management-api",
      "entryFile": "main",
      "sourceRoot": "apps/management-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/management-api/tsconfig.app.json"
      }
    },
    "notification-service": {
      "type": "application",
      "root": "apps/notification-service",
      "entryFile": "main",
      "sourceRoot": "apps/notification-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification-service/tsconfig.app.json"
      }
    },
    "scheduler-service": {
      "type": "application",
      "root": "apps/scheduler-service",
      "entryFile": "main",
      "sourceRoot": "apps/scheduler-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/scheduler-service/tsconfig.app.json"
      }
    },
    "worker-service": {
      "type": "application",
      "root": "apps/worker-service",
      "entryFile": "main",
      "sourceRoot": "apps/worker-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/worker-service/tsconfig.app.json"
      }
    }
  }
}